{
  "name": "agentic-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic commerce and autonomous payment platform",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc",
    "start": "node dist/api/server.js",
    "test": "vitest --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "postinstall": "prisma skills sync || exit 0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "prettier": "^3.9.6",
    "prisma": "^5.22.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.33",
    "@ai-sdk/openai": "^4.0.50",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^5.22.0",
    "ai": "^7.0.83",
    "bullmq": "^6.3.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "razorpay": "^2.9.8",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  }
}
