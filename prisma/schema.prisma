generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  merchants Merchant[]
  sessions  Session[]
}

model Merchant {
  id          String          @id @default(uuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  orders      CommerceOrder[]
  capabilities MerchantCapability[]
  guardrails  MerchantGuardrail?
  user        User            @relation(fields: [userId], references: [id])
}

model Agent {
  id           String            @id @default(uuid())
  owner        String
  role         String
  publicKey    String?
  permissions  Json              @default("[]")
  limits       Json              @default("{}")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  capabilities AgentCapability[]
  credentials  AgentCredential[]
  decisions    PolicyDecision[]
}

model AgentCredential {
  id               String   @id @default(uuid())
  agentId          String
  provider         String
  credentials_hash String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  agent            Agent    @relation(fields: [agentId], references: [id])
}

model AgentCapability {
  id         String   @id @default(uuid())
  agentId    String
  capability String
  limits     Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  agent      Agent    @relation(fields: [agentId], references: [id])
}

model Session {
  id               String           @id @default(uuid())
  userId           String?
  merchantId       String?
  state            String           @default("CREATED")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  orders           CommerceOrder[]
  events           Event[]
  messages         Message[]
  user             User?            @relation(fields: [userId], references: [id])
  skill_executions SkillExecution[]
  tool_calls       ToolCall[]
  revenue_logs     RevenueOpportunityLog[]
}

model Message {
  id        String   @id @default(uuid())
  sessionId String
  sender    String
  receiver  String
  type      String
  payload   Json
  traceId   String?
  timestamp DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])
}

model Skill {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  schema      Json
  version     String
  executions  SkillExecution[]
}

model SkillExecution {
  id        String   @id @default(uuid())
  sessionId String
  skillId   String
  status    String
  result    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  session   Session  @relation(fields: [sessionId], references: [id])
  skill     Skill    @relation(fields: [skillId], references: [id])
}

model ToolCall {
  id          String   @id @default(uuid())
  sessionId   String
  executionId String?
  tool        String
  input       Json
  output      Json?
  status      String
  latency     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  session     Session  @relation(fields: [sessionId], references: [id])
}

model CommerceOrder {
  id         String          @id @default(uuid())
  sessionId  String
  merchantId String
  buyerId    String?
  total      Float
  status     String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  items      CommerceItem[]
  merchant   Merchant        @relation(fields: [merchantId], references: [id])
  session    Session         @relation(fields: [sessionId], references: [id])
  payments   PaymentIntent[]
}

model CommerceItem {
  id        String        @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  order     CommerceOrder @relation(fields: [orderId], references: [id])
}

model PaymentIntent {
  id              String        @id @default(uuid())
  orderId         String
  amount          Float
  status          String
  idempotency_key String        @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           CommerceOrder @relation(fields: [orderId], references: [id])
  refunds         Refund[]
}

model Refund {
  id        String        @id @default(uuid())
  paymentId String
  amount    Float
  status    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  payment   PaymentIntent @relation(fields: [paymentId], references: [id])
}

model Policy {
  id    String @id @default(uuid())
  type  String
  rules Json
}

model PolicyDecision {
  id        String   @id @default(uuid())
  agentId   String
  action    String
  result    String
  reason    String?
  timestamp DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id])
}

model WorkflowRun {
  id            String         @id @default(uuid())
  workflow_type String
  status        String
  state         Json           @default("{}")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  steps         WorkflowStep[]
}

model WorkflowStep {
  id        String      @id @default(uuid())
  runId     String
  step_name String
  status    String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  run       WorkflowRun @relation(fields: [runId], references: [id])
}

model Approval {
  id          String   @id @default(uuid())
  entity_type String
  entity_id   String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id        String   @id @default(uuid())
  sessionId String
  type      String
  payload   Json
  timestamp DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])
}

model ModelRequest {
  id         String   @id @default(uuid())
  provider   String
  model      String
  tokens_in  Int
  tokens_out Int
  latency    Int
  status     String
  createdAt  DateTime @default(now())
}

model EvaluationRun {
  id            String       @id @default(uuid())
  timestamp     DateTime     @default(now())
  scenario      String
  overall_score Float
  evaluations   Evaluation[]
}

model Evaluation {
  id      String        @id @default(uuid())
  runId   String
  task    String
  score   Float
  details Json
  run     EvaluationRun @relation(fields: [runId], references: [id])
}

model WorkflowInstance {
  id           String   @id @default(uuid())
  workflowId   String
  version      Int      @default(1)
  currentState String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model IdempotencyRecord {
  id                 String    @id @default(uuid())
  idempotencyKey     String
  scope              String
  requestFingerprint String
  status             String
  result             Json?
  error              Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  completedAt        DateTime?

  @@unique([scope, idempotencyKey])
}

model WebhookEvent {
  id              String   @id @default(uuid())
  provider        String
  providerEventId String
  eventType       String
  payload         Json
  processedAt     DateTime @default(now())

  @@unique([provider, providerEventId])
}

model OutboxEvent {
  id               String   @id @default(uuid())
  eventId          String   @unique
  eventType        String
  aggregateType    String
  aggregateId      String
  correlationId    String?
  payload          Json
  status           String   @default("PENDING")
  attempts         Int      @default(0)
  availableAt      DateTime @default(now())
  processedAt      DateTime?
  lastError        Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model RevenueOpportunityLog {
  id                  String   @id @default(uuid())
  merchantId          String
  sessionId           String
  buyerId             String?
  opportunityType     String   
  expectedImpactMinor Int
  realizedImpactMinor Int      @default(0)
  status              String   
  orderId             String?  
  paymentIntentId     String?  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  convertedAt         DateTime?
  
  session             Session  @relation(fields: [sessionId], references: [id])
}

model CommerceMessage {
  id              String   @id @default(uuid())
  messageId       String   @unique
  protocolVersion String
  messageType     String
  sessionId       String
  sender          String
  recipient       String
  correlationId   String
  payload         Json
  createdAt       DateTime @default(now())
  expiresAt       DateTime?

  @@index([sessionId])
  @@index([correlationId])
  @@index([messageType])
  @@index([createdAt])
}

model MerchantCapability {
  id         String   @id @default(uuid())
  merchantId String
  capability String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, capability])
}

model MerchantGuardrail {
  id                          String   @id @default(uuid())
  merchantId                  String   @unique
  revenueGoal                 String   @default("BALANCED")
  currency                    String   @default("USD")
  autonomousPaymentLimitMinor Int      @default(0)
  approvalAboveMinor          Int      @default(0)
  maxDiscountBps              Int      @default(0)
  minimumMarginBps            Int      @default(0)
  negotiationEnabled          Boolean  @default(false)
  upsellEnabled               Boolean  @default(false)
  crossSellEnabled            Boolean  @default(false)
  disabledSkills              String[] @default([])
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  
  merchant Merchant @relation(fields: [merchantId], references: [id])
}
